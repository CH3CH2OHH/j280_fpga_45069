// A/B 对调：正占空比驱动电机时，POS 必须是增加的方向，否则速度环变成正反馈。
// 若以后发现方向又反了（POS 随正转减小），把这两行的引脚再换回来。
IO_LOC "ad_otr" F18;
IO_PORT "ad_otr" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "enc_a" AA20;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "enc_b" Y20;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ⚠ XH1 由 TB6612 的 B 通道驱动（原理图 BO1/BO2 -> O1/O2 -> XH1），
//   所以下面端口虽然叫 pwma/ain1/ain2，约束的其实是 B 通道的
//   PWMB=V14、BIN1=AA17、BIN2=V15。A 通道（Y17/Y18/Y19）接 XH2，本工程不用。
IO_LOC "pwma" V14;
IO_PORT "pwma" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "ain1" AA17;
IO_PORT "ain1" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "ain2" V15;
IO_PORT "ain2" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "rxd" L20;
IO_PORT "rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "txd" K20;
IO_PORT "txd" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "led[0]" U18;
IO_PORT "led[0]" IO_TYPE=LVCMOS15 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=1.5;

IO_LOC "led[1]" U19;
IO_PORT "led[1]" IO_TYPE=LVCMOS15 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=1.5;

IO_LOC "led[2]" U17;
IO_PORT "led[2]" IO_TYPE=LVCMOS15 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=1.5;

IO_LOC "led[3]" T17;
IO_PORT "led[3]" IO_TYPE=LVCMOS15 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=1.5;

